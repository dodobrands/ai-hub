#!/usr/bin/env bats
# md-to-blocks.py: мягкие переносы внутри пунктов списка (продолжение по отступу).
#
# Зачем: parse_list прерывал список на первой строке без маркера, поэтому хвост
# перенесённого по ширине пункта уезжал в отдельный параграф (type 1) и в Buildin
# рендерился вне буллета. Репозитории, которые верстают markdown по фиксированной
# колонке, ловили это почти на каждом многострочном пункте.
#
# Сети нет: тест гоняет конвертер локально и сверяет плоский слепок дерева блоков.

setup() {
    SCRIPT="$BATS_TEST_DIRNAME/../scripts/md-to-blocks.py"
    SANDBOX="$(mktemp -d)"

    # Слепок дерева: "<путь> <type> <текст сегментов>" по одной строке на блок.
    # Путь — индексы от корня через точку (0, 0.1), текст — склейка сегментов,
    # чтобы в ожиданиях был виден и join, и inline-разметка.
    cat > "$SANDBOX/summary.py" <<'PY'
import json
import sys

blocks = json.load(sys.stdin)


def walk(nodes, prefix=""):
    for idx, b in enumerate(nodes):
        path = f"{prefix}{idx}"
        segs = b.get("data", {}).get("segments", [])
        text = "".join(s.get("text", "") for s in segs)
        print(f"{path} {b.get('type')} {text}")
        walk(b.get("children", []), prefix=f"{path}.")


walk(blocks)
PY

    # Сегменты одного блока: "<enhancer-флаги|url> <текст>" — для проверки, что
    # разметка через перенос строки собирается в один сегмент, а не рвётся.
    cat > "$SANDBOX/segments.py" <<'PY'
import json
import sys

blocks = json.load(sys.stdin)
block = blocks[int(sys.argv[1])]
for s in block["data"]["segments"]:
    marks = ",".join(sorted(k for k, v in s.get("enhancer", {}).items() if v))
    print(f"{marks or '-'}{'|' + s['url'] if s.get('url') else ''} {s['text']}")
PY
}

teardown() {
    rm -rf "$SANDBOX"
}

# markdown со stdin → плоский слепок дерева блоков
summary() {
    python3 "$SCRIPT" - | python3 "$SANDBOX/summary.py"
}

# markdown со stdin → сегменты блока $1
segments() {
    python3 "$SCRIPT" - | python3 "$SANDBOX/segments.py" "$1"
}

@test "перенесённый буллет остаётся одним пунктом, хвост клеится через пробел" {
    run summary <<'MD'
- **Первый пункт:** начало пункта, которое не влезло в одну строку и поэтому
  продолжается с отступом в две позиции.
- Второй пункт.
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${#lines[@]}" -eq 2 ]
    [ "${lines[0]}" = "0 4 Первый пункт: начало пункта, которое не влезло в одну строку и поэтому продолжается с отступом в две позиции." ]
    [ "${lines[1]}" = "1 4 Второй пункт." ]
    # ни двойного пробела на стыке, ни осиротевшего параграфа
    [[ "$output" != *"  "* ]]
    [[ "$output" != *" 1 "* ]]
}

@test "перенос в нумерованном пункте: один блок type 5" {
    run summary <<'MD'
1. Первый шаг, у которого описание не влезло в одну строку и
   поэтому продолжено с отступом.
2. Второй шаг.
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${#lines[@]}" -eq 2 ]
    [ "${lines[0]}" = "0 5 Первый шаг, у которого описание не влезло в одну строку и поэтому продолжено с отступом." ]
    [ "${lines[1]}" = "1 5 Второй шаг." ]
}

@test "перенос в todo-пункте: один блок type 3, checked сохраняется" {
    run summary <<'MD'
- [x] Сделанная задача с длинным описанием, которое перенесено
      на следующую строку.
- [ ] Ещё не сделанная задача.
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${#lines[@]}" -eq 2 ]
    [ "${lines[0]}" = "0 3 Сделанная задача с длинным описанием, которое перенесено на следующую строку." ]
    [ "${lines[1]}" = "1 3 Ещё не сделанная задача." ]

    cat > "$SANDBOX/todo.md" <<'MD'
- [x] Сделанная задача с длинным описанием, которое перенесено
      на следующую строку.
MD
    run bash -c "python3 '$SCRIPT' '$SANDBOX/todo.md' | python3 -c 'import json,sys; print(json.load(sys.stdin)[0][\"data\"][\"checked\"])'"
    echo "$output"
    [ "$status" -eq 0 ]
    [ "$output" = "True" ]
}

@test "настоящая вложенность не ломается: маркер с отступом остаётся дочерним" {
    run summary <<'MD'
- Родительский пункт
  - Вложенный пункт
  1. Вложенный нумерованный
  - [ ] Вложенный чек-бокс
- Второй родительский пункт
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${#lines[@]}" -eq 5 ]
    [ "${lines[0]}" = "0 4 Родительский пункт" ]
    [ "${lines[1]}" = "0.0 4 Вложенный пункт" ]
    [ "${lines[2]}" = "0.1 5 Вложенный нумерованный" ]
    [ "${lines[3]}" = "0.2 3 Вложенный чек-бокс" ]
    [ "${lines[4]}" = "1 4 Второй родительский пункт" ]
}

@test "вложенный пункт со своим переносом клеится к вложенному, не к родителю" {
    run summary <<'MD'
- Родительский пункт
  - Вложенный пункт с описанием, которое не влезло
    в одну строку.
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${#lines[@]}" -eq 2 ]
    [ "${lines[0]}" = "0 4 Родительский пункт" ]
    [ "${lines[1]}" = "0.0 4 Вложенный пункт с описанием, которое не влезло в одну строку." ]
}

@test "inline-разметка через стык переноса собирается в один сегмент" {
    run segments 0 <<'MD'
- начало **жирный
  текст** и `моно
  код` и [ссылка на
  документацию](https://example.invalid/doc) конец
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${lines[0]}" = "- начало " ]
    [ "${lines[1]}" = "bold жирный текст" ]
    [ "${lines[2]}" = "-  и " ]
    [ "${lines[3]}" = "code моно код" ]
    [ "${lines[4]}" = "-  и " ]
    [ "${lines[5]}" = "-|https://example.invalid/doc ссылка на документацию" ]
    [ "${lines[6]}" = "-  конец" ]
}

@test "абзац после списка через пустую строку остаётся отдельным параграфом" {
    run summary <<'MD'
- Пункт списка с переносом, который
  продолжается ниже.

Это уже обычный абзац, а не продолжение пункта.
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${#lines[@]}" -eq 2 ]
    [ "${lines[0]}" = "0 4 Пункт списка с переносом, который продолжается ниже." ]
    [ "${lines[1]}" = "1 1 Это уже обычный абзац, а не продолжение пункта." ]
}

@test "другие конструкции после переноса не всасываются в пункт" {
    run summary <<'MD'
- Пункт с переносом, который
  продолжается ниже.
  | a | b |
  | --- | --- |
  | 1 | 2 |
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${lines[0]}" = "0 4 Пункт с переносом, который продолжается ниже." ]
    [ "${lines[1]}" = "1 27 " ]
}

@test "выноска: каждая строка > остаётся отдельной строкой (поведение не менялось)" {
    cat > "$SANDBOX/callout.md" <<'MD'
> **Источник:** запись встречи
> **Участники:** трое
MD
    run bash -c "python3 '$SCRIPT' '$SANDBOX/callout.md' | python3 -c '
import json, sys
block = json.load(sys.stdin)[0]
print(block[\"type\"])
print(json.dumps(\"\".join(s[\"text\"] for s in block[\"data\"][\"segments\"]), ensure_ascii=False))
'"
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${lines[0]}" = "13" ]
    [[ "${lines[1]}" == *'\n'* ]]
}

@test "граница: хвост БЕЗ отступа не приклеивается (истинный lazy continuation не поддержан)" {
    # CommonMark склеил бы и такую строку, но здесь она осознанно оставлена
    # отдельным параграфом: без отступа неотличимо от начала нового абзаца.
    run summary <<'MD'
- Пункт списка, продолжение которого
не имеет отступа вообще.
MD
    echo "$output"
    [ "$status" -eq 0 ]
    [ "${lines[0]}" = "0 4 Пункт списка, продолжение которого" ]
    [ "${lines[1]}" = "1 1 не имеет отступа вообще." ]
}
